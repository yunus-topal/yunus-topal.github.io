---
// src/components/game.astro
// An Astro component that lists and embeds multiple Unity WebGL games with native lazy-loading.
const games = [
  { name: 'Sudoku', url: '/webgl/Sudoku/index.html' },
  //{ name: 'My Second Unity Game', url: '/webgl/game2/index.html' },
  // Add more games here:
  // { name: 'Another Game', url: '/webgl/anotherGame/index.html' },
];
---

<section id="games" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Games
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full bg-blue-500"></div>
      </div>
      <div class="lg:col-span-8 space-y-8">
        <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
          I enjoy creating games and sharing them with others. Feel free to try the games below! 
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      {games.map((game) => (
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
          <h3 class="text-xl font-semibold mb-4 px-4 text-gray-900 dark:text-white">{game.name}</h3>
          <div class="relative w-full pb-[56.25%]">
            <iframe
              src={game.url}
              loading="lazy"
              frameborder="0"
              allowfullscreen
              title={game.name}
              class="absolute inset-0 w-full h-full"
            ></iframe>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
